generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  VISITOR
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum BookStatus {
  AVAILABLE
  BORROWED
  RESERVED
  LOST
  UNDER_MAINTENANCE
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum ReservationStatus {
  PENDING
  READY
  EXPIRED
  CANCELLED
  FULFILLED
}

enum NotificationType {
  OVERDUE
  BOOK_AVAILABLE
  NEW_ACQUISITION
  ANNOUNCEMENT
  RESERVATION_EXPIRING
  GENERAL
}

enum NewsCategory {
  ANNOUNCEMENT
  EVENT
  CONFERENCE
  NEW_BOOK
  GENERAL
}

enum CheckInMethod {
  QR_CODE
  MANUAL
  CARD
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  username      String       @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole     @default(STUDENT)
  status        UserStatus   @default(PENDING)
  photo         String?
  qrCode        String?
  libraryCard   String?      @unique
  department    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  loans         Loan[]
  reservations  Reservation[]
  attendances   Attendance[]
  notifications Notification[]
  accounts      Account[]
  sessions      Session[]

  @@index([email])
  @@index([username])
  @@index([status])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id              String        @id @default(cuid())
  externalId      String        @unique
  title           String
  author          String
  isbn            String        @unique
  publisher       String?
  summary         String?       @db.Text
  coverImage      String?
  year            Int?
  department      String
  category        String
  location        String?
  totalCopies     Int           @default(1)
  availableCopies Int           @default(1)
  status          BookStatus    @default(AVAILABLE)
  isNew           Boolean       @default(false)
  loanCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  loans           Loan[]
  reservations    Reservation[]

  @@index([title])
  @@index([author])
  @@index([isbn])
  @@index([department])
  @@index([category])
  @@index([status])
  @@index([isNew])
}

model Loan {
  id            String      @id @default(cuid())
  userId        String
  bookId        String
  borrowDate    DateTime    @default(now())
  dueDate       DateTime
  returnDate    DateTime?
  status        LoanStatus  @default(ACTIVE)
  renewalCount  Int         @default(0)
  fineAmount    Decimal?    @db.Decimal(10, 2)
  user          User        @relation(fields: [userId], references: [id])
  book          Book        @relation(fields: [bookId], references: [id])

  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model Reservation {
  id           String             @id @default(cuid())
  userId       String
  bookId       String
  requestDate  DateTime           @default(now())
  expiryDate   DateTime?
  status       ReservationStatus  @default(PENDING)
  notifiedAt   DateTime?
  user         User               @relation(fields: [userId], references: [id])
  book         Book               @relation(fields: [bookId], references: [id])

  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model Attendance {
  id        String        @id @default(cuid())
  userId    String
  checkIn   DateTime      @default(now())
  checkOut  DateTime?
  method    CheckInMethod @default(QR_CODE)
  user      User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

model News {
  id           String       @id @default(cuid())
  title        String
  content      String       @db.Text
  image        String?
  category     NewsCategory @default(ANNOUNCEMENT)
  publishedAt  DateTime     @default(now())
  isPublished  Boolean      @default(true)
  createdAt    DateTime     @default(now())

  @@index([publishedAt])
  @@index([isPublished])
  @@index([category])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

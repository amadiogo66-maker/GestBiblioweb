generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  VISITOR
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum BookStatus {
  AVAILABLE
  BORROWED
  RESERVED
  LOST
  UNDER_MAINTENANCE
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum ReservationStatus {
  PENDING
  READY
  EXPIRED
  CANCELLED
  FULFILLED
}

enum NotificationType {
  OVERDUE
  BOOK_AVAILABLE
  NEW_ACQUISITION
  ANNOUNCEMENT
  RESERVATION_EXPIRING
  GENERAL
}

enum NewsCategory {
  ANNOUNCEMENT
  EVENT
  CONFERENCE
  NEW_BOOK
  GENERAL
}

enum CheckInMethod {
  QR_CODE
  MANUAL
  CARD
}

/// Rôles du personnel du site. Distinct de UserRole (piloté par le logiciel
/// externe) : jamais lu ni écrit par les webhooks de synchronisation.
enum StaffRole {
  ADMIN
  LIBRARIAN
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  username      String       @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole     @default(STUDENT)
  status        UserStatus   @default(PENDING)
  autoSuspendedAt DateTime?
  photo         String?
  qrCode        String?
  libraryCard   String?      @unique
  department    String?
  matricule     String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  libraryMember LibraryMember? @relation(fields: [matricule], references: [matricule])
  loans         Loan[]
  reservations  Reservation[]
  attendances   Attendance[]
  notifications Notification[]
  accounts      Account[]
  sessions      Session[]
  staffAssignments        StaffAssignment[] @relation("StaffAssignmentUser")
  staffAssignmentsGranted StaffAssignment[] @relation("StaffAssignmentGrantedBy")
  /// Rattachement officiel facultatif. La colonne texte `department` reste la source de lecture.
  departmentId       String?
  programId          String?
  officialDepartment Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  officialProgram    Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([username])
  @@index([status])
  @@index([role])
  @@index([departmentId])
  @@index([programId])
}

model LibraryMember {
  id                String    @id @default(cuid())
  matricule         String    @unique
  nom               String
  prenom            String
  dateNaissance     DateTime
  email             String?
  role              UserRole  @default(STUDENT)
  departement       String?
  inscriptionActive Boolean   @default(true)
  dateExpiration    DateTime?
  syncedAt          DateTime  @updatedAt
  createdAt         DateTime  @default(now())
  user              User?
  /// Rattachement officiel facultatif. La colonne texte `departement` reste la source de lecture.
  departmentId       String?
  programId          String?
  officialDepartment Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  officialProgram    Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([inscriptionActive])
  @@index([departmentId])
  @@index([programId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id              String        @id @default(cuid())
  externalId      String        @unique
  title           String
  author          String
  isbn            String        @unique
  publisher       String?
  summary         String?       @db.Text
  coverImage      String?
  year            Int?
  department      String
  category        String
  location        String?
  totalCopies     Int           @default(1)
  availableCopies Int           @default(1)
  status          BookStatus    @default(AVAILABLE)
  isNew           Boolean       @default(false)
  loanCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  loans           Loan[]
  reservations    Reservation[]
  /// Rattachement officiel facultatif. La colonne texte `department` reste la source de lecture.
  departmentId       String?
  officialDepartment Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([author])
  @@index([isbn])
  @@index([department])
  @@index([departmentId])
  @@index([category])
  @@index([status])
  @@index([isNew])
}

model Loan {
  id            String      @id @default(cuid())
  userId        String
  bookId        String
  borrowDate    DateTime    @default(now())
  dueDate       DateTime
  returnDate    DateTime?
  status        LoanStatus  @default(ACTIVE)
  renewalCount  Int         @default(0)
  fineAmount    Decimal?    @db.Decimal(10, 2)
  user          User        @relation(fields: [userId], references: [id])
  book          Book        @relation(fields: [bookId], references: [id])

  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model Reservation {
  id           String             @id @default(cuid())
  userId       String
  bookId       String
  requestDate  DateTime           @default(now())
  expiryDate   DateTime?
  status       ReservationStatus  @default(PENDING)
  notifiedAt   DateTime?
  user         User               @relation(fields: [userId], references: [id])
  book         Book               @relation(fields: [bookId], references: [id])

  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model Attendance {
  id        String        @id @default(cuid())
  userId    String
  checkIn   DateTime      @default(now())
  checkOut  DateTime?
  method    CheckInMethod @default(QR_CODE)
  user      User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

model News {
  id           String       @id @default(cuid())
  title        String
  content      String       @db.Text
  image        String?
  category     NewsCategory @default(ANNOUNCEMENT)
  publishedAt  DateTime     @default(now())
  isPublished  Boolean      @default(true)
  createdAt    DateTime     @default(now())

  @@index([publishedAt])
  @@index([isPublished])
  @@index([category])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// Affectation d'un rôle du personnel. Une ligne par (utilisateur, rôle) ;
/// la révocation renseigne revokedAt au lieu de supprimer (traçabilité).
model StaffAssignment {
  id          String    @id @default(cuid())
  userId      String
  role        StaffRole
  grantedById String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  user        User      @relation("StaffAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?     @relation("StaffAssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([grantedById])
}

/// Compteur de limitation de tentatives (fenêtre fixe). La clé est toujours
/// un hachage : aucune donnée brute (IP, email, matricule) n'y figure.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// --- Structure officielle de l'Université de Labé ----------------------------
// Référentiel chargé depuis prisma/data/ul-structure.ts (slugs figés).

enum ProgramLevel {
  LICENCE
  LICENCE_FONDAMENTALE
  DUT
}

model Faculty {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  sortOrder   Int
  departments Department[]
}

model Department {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  facultyId String
  sortOrder Int
  faculty   Faculty           @relation(fields: [facultyId], references: [id])
  programs  Program[]
  aliases   DepartmentAlias[]
  users     User[]
  members   LibraryMember[]
  books     Book[]

  @@index([facultyId])
}

model Program {
  id           String          @id @default(cuid())
  slug         String
  name         String
  level        ProgramLevel
  departmentId String
  sortOrder    Int
  department   Department      @relation(fields: [departmentId], references: [id])
  users        User[]
  members      LibraryMember[]

  @@unique([departmentId, slug])
}

/// Variante d'écriture (déjà normalisée) d'un nom de département → département officiel.
model DepartmentAlias {
  id           String     @id @default(cuid())
  normalized   String     @unique
  departmentId String
  note         String?
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

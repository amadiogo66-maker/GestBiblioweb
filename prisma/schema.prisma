generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  VISITOR
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum BookStatus {
  AVAILABLE
  BORROWED
  RESERVED
  LOST
  UNDER_MAINTENANCE
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum ReservationStatus {
  PENDING
  READY
  EXPIRED
  CANCELLED
  FULFILLED
}

enum NotificationType {
  OVERDUE
  BOOK_AVAILABLE
  NEW_ACQUISITION
  ANNOUNCEMENT
  RESERVATION_EXPIRING
  GENERAL
}

enum NewsCategory {
  ANNOUNCEMENT
  EVENT
  CONFERENCE
  NEW_BOOK
  GENERAL
}

enum CheckInMethod {
  QR_CODE
  MANUAL
  CARD
}

/// Rôles du personnel du site. Distinct de UserRole (piloté par le logiciel
/// externe) : jamais lu ni écrit par les webhooks de synchronisation.
enum StaffRole {
  ADMIN
  LIBRARIAN
  /// Responsable d'un département : departmentId obligatoire (contrainte CHECK).
  DEPARTMENT_MANAGER
}

enum ReadingListStatus {
  DRAFT
  PUBLISHED
}

enum AcquisitionStatus {
  SUBMITTED
  DEPT_APPROVED
  DEPT_REJECTED
  LIBRARY_ACCEPTED
  LIBRARY_REJECTED
  ACQUIRED
}

model User {
  id                          String               @id @default(cuid())
  email                       String               @unique
  username                    String               @unique
  password                    String
  firstName                   String
  lastName                    String
  role                        UserRole             @default(STUDENT)
  status                      UserStatus           @default(PENDING)
  autoSuspendedAt             DateTime?
  photo                       String?
  qrCode                      String?
  libraryCard                 String?              @unique
  department                  String?
  matricule                   String?              @unique
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  libraryMember               LibraryMember?       @relation(fields: [matricule], references: [matricule])
  loans                       Loan[]
  reservations                Reservation[]
  attendances                 Attendance[]
  notifications               Notification[]
  accounts                    Account[]
  sessions                    Session[]
  staffAssignments            StaffAssignment[]    @relation("StaffAssignmentUser")
  staffAssignmentsGranted     StaffAssignment[]    @relation("StaffAssignmentGrantedBy")
  staffMfa                    StaffMfa?
  staffRecoveryCodes          StaffRecoveryCode[]
  /// Rattachement officiel facultatif. La colonne texte `department` reste la source de lecture.
  departmentId                String?
  programId                   String?
  officialDepartment          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  officialProgram             Program?             @relation(fields: [programId], references: [id], onDelete: SetNull)
  readingLists                ReadingList[]
  acquisitionRequests         AcquisitionRequest[] @relation("AcquisitionRequester")
  acquisitionDeptDecisions    AcquisitionRequest[] @relation("AcquisitionDepartmentDecider")
  acquisitionLibraryDecisions AcquisitionRequest[] @relation("AcquisitionLibraryDecider")

  @@index([email])
  @@index([username])
  @@index([status])
  @@index([role])
  @@index([departmentId])
  @@index([programId])
}

model LibraryMember {
  id                 String      @id @default(cuid())
  matricule          String      @unique
  nom                String
  prenom             String
  dateNaissance      DateTime
  email              String?
  role               UserRole    @default(STUDENT)
  departement        String?
  inscriptionActive  Boolean     @default(true)
  dateExpiration     DateTime?
  syncedAt           DateTime    @updatedAt
  createdAt          DateTime    @default(now())
  user               User?
  /// Rattachement officiel facultatif. La colonne texte `departement` reste la source de lecture.
  departmentId       String?
  programId          String?
  officialDepartment Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  officialProgram    Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([inscriptionActive])
  @@index([departmentId])
  @@index([programId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id                 String            @id @default(cuid())
  externalId         String            @unique
  title              String
  author             String
  isbn               String            @unique
  publisher          String?
  summary            String?           @db.Text
  coverImage         String?
  year               Int?
  department         String
  category           String
  location           String?
  totalCopies        Int               @default(1)
  availableCopies    Int               @default(1)
  status             BookStatus        @default(AVAILABLE)
  isNew              Boolean           @default(false)
  loanCount          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  loans              Loan[]
  reservations       Reservation[]
  readingListItems   ReadingListItem[]
  /// Rattachement officiel facultatif. La colonne texte `department` reste la source de lecture.
  departmentId       String?
  officialDepartment Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([author])
  @@index([isbn])
  @@index([department])
  @@index([departmentId])
  @@index([category])
  @@index([status])
  @@index([isNew])
}

model Loan {
  id                 String     @id @default(cuid())
  /// Null : prêt d'un membre sans compte web (rattaché à l'inscription via matricule).
  userId             String?
  bookId             String
  borrowDate         DateTime   @default(now())
  dueDate            DateTime
  returnDate         DateTime?
  status             LoanStatus @default(ACTIVE)
  renewalCount       Int        @default(0)
  fineAmount         Decimal?   @db.Decimal(10, 2)
  /// Identifiant du prêt dans le logiciel de gestion, propriétaire des prêts.
  externalId         String?    @unique
  matricule          String?
  /// Demande de renouvellement en attente de traitement par le logiciel.
  renewalRequestedAt DateTime?
  /// Dernier refus de renouvellement décidé par le logiciel (levé si l'échéance change).
  renewalRefusedAt   DateTime?
  user               User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  book               Book       @relation(fields: [bookId], references: [id])

  @@index([userId])
  @@index([bookId])
  @@index([status])
  @@index([matricule])
}

/// Index unique PARTIEL (userId, bookId) WHERE status IN ('PENDING','READY') :
/// écrit à la main dans la migration, Prisma ne sait pas le décrire ici.
model Reservation {
  id          String            @id @default(cuid())
  userId      String
  bookId      String
  requestDate DateTime          @default(now())
  expiryDate  DateTime?
  status      ReservationStatus @default(PENDING)
  notifiedAt  DateTime?
  user        User              @relation(fields: [userId], references: [id])
  book        Book              @relation(fields: [bookId], references: [id])

  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model Attendance {
  id       String        @id @default(cuid())
  userId   String
  checkIn  DateTime      @default(now())
  checkOut DateTime?
  method   CheckInMethod @default(QR_CODE)
  user     User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  /// Clé d'idempotence : une même notification n'est jamais créée deux fois.
  dedupeKey String?          @unique
  /// "site" ou "software".
  source    String           @default("site")
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

model News {
  id          String       @id @default(cuid())
  title       String
  content     String       @db.Text
  image       String?
  category    NewsCategory @default(ANNOUNCEMENT)
  publishedAt DateTime     @default(now())
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@index([publishedAt])
  @@index([isPublished])
  @@index([category])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// Affectation d'un rôle du personnel. Une ligne par (utilisateur, rôle) ;
/// la révocation renseigne revokedAt au lieu de supprimer (traçabilité).
model StaffAssignment {
  id           String      @id @default(cuid())
  userId       String
  role         StaffRole
  grantedById  String?
  createdAt    DateTime    @default(now())
  revokedAt    DateTime?
  /// Obligatoire pour DEPARTMENT_MANAGER, interdit pour ADMIN et LIBRARIAN (contrainte CHECK).
  departmentId String?
  user         User        @relation("StaffAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User?       @relation("StaffAssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Unicité écrite à la main dans la migration (index partiels) :
  //   (userId, role) quand departmentId est NULL ; (userId, role, departmentId) sinon.
  @@index([userId])
  @@index([grantedById])
  @@index([departmentId])
}

/// Compteur de limitation de tentatives (fenêtre fixe). La clé est toujours
/// un hachage : aucune donnée brute (IP, email, matricule) n'y figure.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// --- Structure officielle de l'Université de Labé ----------------------------
// Référentiel chargé depuis prisma/data/ul-structure.ts (slugs figés).

enum ProgramLevel {
  LICENCE
  LICENCE_FONDAMENTALE
  DUT
}

model Faculty {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  sortOrder   Int
  departments Department[]
}

model Department {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  facultyId           String
  sortOrder           Int
  faculty             Faculty              @relation(fields: [facultyId], references: [id])
  programs            Program[]
  aliases             DepartmentAlias[]
  users               User[]
  members             LibraryMember[]
  books               Book[]
  staffAssignments    StaffAssignment[]
  readingLists        ReadingList[]
  acquisitionRequests AcquisitionRequest[]

  @@index([facultyId])
}

model Program {
  id           String          @id @default(cuid())
  slug         String
  name         String
  level        ProgramLevel
  departmentId String
  sortOrder    Int
  department   Department      @relation(fields: [departmentId], references: [id])
  users        User[]
  members      LibraryMember[]
  readingLists ReadingList[]

  @@unique([departmentId, slug])
}

/// Variante d'écriture (déjà normalisée) d'un nom de département → département officiel.
model DepartmentAlias {
  id           String     @id @default(cuid())
  normalized   String     @unique
  departmentId String
  note         String?
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// --- Double authentification du personnel (TOTP) ------------------------------

/// Secret TOTP d'un membre du personnel. secretCipher = AES-256-GCM
/// (iv + tag + chiffré, en base64) ; chaîne vide = aucun secret (après reset).
/// enabledAt null = enrôlement en cours. epoch invalide les preuves (cookies)
/// existantes quand il est incrémenté.
model StaffMfa {
  id           String    @id @default(cuid())
  userId       String    @unique
  secretCipher String
  enabledAt    DateTime?
  epoch        Int       @default(1)
  lastUsedStep Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Code de secours à usage unique (stocké haché, jamais en clair).
model StaffRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Boîte d'envoi : demandes des utilisateurs, lues puis acquittées par le logiciel.
/// Aucune donnée personnelle superflue dans payload (matricule, identifiants, dates).
model SiteEvent {
  seq         Int       @id @default(autoincrement())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt, seq])
}

// --- Listes de lectures et propositions d'acquisition ---------------------------

/// Liste de lectures d'un cours, créée par un enseignant, dans SON département.
model ReadingList {
  id           String            @id @default(cuid())
  ownerId      String
  departmentId String
  programId    String?
  title        String            @db.VarChar(150)
  courseCode   String?           @db.VarChar(40)
  description  String?           @db.VarChar(1000)
  academicYear String?           @db.VarChar(9)
  status       ReadingListStatus @default(DRAFT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program      Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  items        ReadingListItem[]

  @@index([departmentId, status])
  @@index([ownerId])
  @@index([programId])
}

model ReadingListItem {
  id        String      @id @default(cuid())
  listId    String
  bookId    String
  note      String?     @db.VarChar(500)
  position  Int
  createdAt DateTime    @default(now())
  list      ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  book      Book        @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([listId, bookId])
  @@index([bookId])
}

/// Proposition d'acquisition : enseignant → responsable du département → bibliothèque.
model AcquisitionRequest {
  id                    String            @id @default(cuid())
  requesterId           String
  departmentId          String
  title                 String            @db.VarChar(200)
  author                String            @db.VarChar(150)
  isbn                  String?           @db.VarChar(20)
  publisher             String?           @db.VarChar(150)
  year                  Int?
  justification         String            @db.VarChar(1000)
  status                AcquisitionStatus @default(SUBMITTED)
  departmentDecidedById String?
  departmentDecidedAt   DateTime?
  departmentNote        String?           @db.VarChar(500)
  libraryDecidedById    String?
  libraryDecidedAt      DateTime?
  libraryNote           String?           @db.VarChar(500)
  acquiredAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  requester             User              @relation("AcquisitionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  department            Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentDecidedBy   User?             @relation("AcquisitionDepartmentDecider", fields: [departmentDecidedById], references: [id], onDelete: SetNull)
  libraryDecidedBy      User?             @relation("AcquisitionLibraryDecider", fields: [libraryDecidedById], references: [id], onDelete: SetNull)

  @@index([departmentId, status])
  @@index([requesterId, createdAt])
  @@index([status])
}

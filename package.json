{
  "name": "gest-biblio-web",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.0"
    },
    "tsx": {
      "esbuild": "0.25.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo-books": "tsx prisma/add-demo-books.ts",
    "db:seed-structure": "tsx scripts/seed-structure.ts",
    "db:backfill-departments": "tsx scripts/backfill-departments.ts",
    "db:seed-demo-loans": "tsx scripts/seed-demo-loans.ts",
    "events:purge": "tsx scripts/events-purge.ts",
    "db:studio": "prisma studio",
    "staff:grant": "tsx scripts/staff-grant.ts grant",
    "staff:revoke": "tsx scripts/staff-grant.ts revoke",
    "staff:mfa-reset": "tsx scripts/staff-mfa-reset.ts",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npx prisma migrate dev && npx prisma db seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",

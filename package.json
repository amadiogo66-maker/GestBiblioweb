    "lucide-react": "0.468.0",
    "next": "^15.1.7",
    "next-auth": "^5.0.0-beta.32",
    "otpauth": "9.6.0",
    "prisma": "5.15.0",
    "qrcode": "1.5.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.0",
    "tailwind-merge": "2.5.0",
    "zod": "3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.14.15",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "10.4.20",
    "esbuild": "^0.25.0",

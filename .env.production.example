# =============================================================================
# Gest Biblio Web — production sur le serveur de l'université (Docker, sans Vercel)
#
# Copier en .env.production (même dossier que docker-compose.prod.yml), puis :
#   chmod 600 .env.production
# Ce fichier contient des secrets : jamais dans Git, jamais dans une image,
# jamais envoyé par e-mail. Il est lu par deploy/compose.sh.
#
# Générer chaque secret sur le serveur (une valeur différente pour chacun) :
#   openssl rand -hex 32       → POSTGRES_PASSWORD, GEST_BIBLIO_API_KEY
#   openssl rand -base64 32    → NEXTAUTH_SECRET, STAFF_MFA_KEY
#
# DATABASE_URL n'est PAS à définir ici : docker-compose.prod.yml la construit à
# partir des variables POSTGRES_* ci-dessous (hôte "postgres", réseau interne).
# =============================================================================

# --- Base PostgreSQL (conteneur "postgres", jamais exposé) -----------------------
# [PUBLIC] Nom de la base. Vide = gestbiblio.
POSTGRES_DB=
# [PUBLIC] Utilisateur de la base. Vide = gestbiblio.
POSTGRES_USER=
# [SECRET] Obligatoire. Mot de passe de la base : openssl rand -hex 32
# (hexadécimal : utilisable tel quel dans l'URL de connexion).
# Ne PAS le changer ici après la première installation sans le changer aussi
# dans la base (ALTER USER) : le volume garde l'ancien mot de passe.
POSTGRES_PASSWORD=

# --- Adresse du site et HTTPS (conteneur "caddy") --------------------------------
# [PUBLIC] Obligatoire. Nom de domaine (certificat public automatique) ou nom /
# adresse du réseau local (avec CADDY_TLS="tls internal"). Sans "https://".
SITE_ADDRESS=
# [PUBLIC] Vide = certificat public (Let's Encrypt). "tls internal" = autorité
# locale de Caddy (réseau local sans accès Internet entrant, ou test).
CADDY_TLS=

# --- Auth.js (sessions) ------------------------------------------------------------
# [SECRET] Obligatoire. openssl rand -base64 32. Le changer déconnecte tout le monde.
NEXTAUTH_SECRET=
# [PUBLIC] Facultatif : URL publique complète, ex. https://biblio.exemple.org.
# Laisser en commentaire sauf besoin : l'hôte est déduit des en-têtes posés par Caddy.
# AUTH_URL=

# --- Double authentification du personnel ------------------------------------------
# [SECRET] Obligatoire. 32 octets en base64 : openssl rand -base64 32
# Chiffre les secrets TOTP et signe les preuves de vérification.
# À SAUVEGARDER À PART, hors de la base et hors des sauvegardes de la base.
# La perdre ou la changer impose un staff:mfa-reset de chaque membre du personnel.
STAFF_MFA_KEY=

# --- Logiciel de gestion de la bibliothèque ----------------------------------------
# [SECRET] Obligatoire pour les webhooks (/api/*/sync, /api/events). Clé attendue
# dans l'en-tête x-api-key : openssl rand -hex 32. À transmettre au logiciel par
# un canal sûr. Absente : les webhooks répondent 500.
GEST_BIBLIO_API_KEY=

# --- Adresse IP des visiteurs ------------------------------------------------------
# [PUBLIC] Vide = x-forwarded-for, posé (écrasé) par Caddy. À ne changer que si un
# autre proxy est placé devant : voir GUIDE_EXPLOITATION.md, section proxy.
CLIENT_IP_HEADER=

# --- Images Docker -------------------------------------------------------------------
# [PUBLIC] Étiquette des images construites (ex. date ou version). Vide = latest.
# Garder l'étiquette précédente permet le retour en arrière.
APP_TAG=

# =============================================================================
# Gest Biblio Web — variables d'environnement
# Copier ce fichier en .env pour le développement local, puis renseigner les
# valeurs. Ne JAMAIS committer de vraies valeurs.
# [SECRET] = valeur confidentielle ; [PUBLIC] = valeur non sensible.
# =============================================================================

# --- Base de données (lue par Prisma : schema.prisma) -------------------------
# [SECRET] Obligatoire. Contient le mot de passe de la base.
# Local (docker-compose) : postgresql://USER:PASSWORD@localhost:5433/gestbiblio?schema=public
# Vercel + Neon          : URL "pooled" (hôte contenant -pooler) fournie par Neon
DATABASE_URL=""

# --- Auth.js v5 (lib/auth.ts) ---------------------------------------------------
# [SECRET] Obligatoire. Générer avec : npx auth secret  (ou openssl rand -base64 32)
# Auth.js accepte aussi le nom AUTH_SECRET.
NEXTAUTH_SECRET=""

# [PUBLIC] Optionnel. URL publique du site. En local : http://localhost:3000
# Sur Vercel : NE PAS définir (trustHost + détection automatique de l'hôte).
# Alias reconnu par Auth.js : AUTH_URL.
NEXTAUTH_URL=""

# --- API de synchronisation Gest Biblio (app/api/*/sync) -----------------------
# [SECRET] Optionnel. Clé attendue dans l'en-tête x-api-key des webhooks de
# synchronisation. Absente => les routes /api/*/sync répondent 500.
GEST_BIBLIO_API_KEY=""

# --- Seed (prisma/seed.ts, exécuté manuellement, jamais sur Vercel) -----------
# [SECRET] Optionnel. Mot de passe du compte de test test@test.com.
# Valeur par défaut si absent : Test1234!
SEED_TEST_PASSWORD=""

# --- Variables actuellement NON lues par le code (réservées / futures) ---------
# [PUBLIC] URL de l'API Gest Biblio existante
GEST_BIBLIO_API_URL=""
# [PUBLIC] Dossier d'upload
UPLOAD_DIR=""
# [SECRET] Clé API Brevo (envoi d'e-mails, non implémenté)
BREVO_API_KEY=""
# [PUBLIC] Adresse d'expédition des e-mails
EMAIL_FROM=""
# [PUBLIC] URL publique de l'application (exposée au navigateur)
NEXT_PUBLIC_APP_URL=""

# --- Gérées automatiquement (ne pas définir) -----------------------------------
# NODE_ENV : positionné par Next.js ("production" sur Vercel)
# VERCEL   : positionné par Vercel (active trustHost côté Auth.js)

# Configuration de deploy/backup-db.sh. Copier en deploy/backup.env (chmod 600).
# Aucune valeur secrète ici : seulement une clé PUBLIQUE de chiffrement.
BACKUP_DIR=/var/backups/gestbiblio
BACKUP_RETENTION_DAYS=14
# Chiffrement (l'un OU l'autre) : clé publique age (age1...) ou destinataire gpg.
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
# Copie hors site : le fichier est passé en $1. Exemples :
#   BACKUP_OFFSITE_COMMAND='rclone copy "$1" distant:gestbiblio/'
#   BACKUP_OFFSITE_COMMAND='rsync -a "$1" sauvegarde@serveur2:/srv/gestbiblio/'
BACKUP_OFFSITE_COMMAND=
